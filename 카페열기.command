#!/bin/bash
# ============================================================
# 카페열기.command — 맥용 바로가기
#
# 더블클릭하면 크롬을 켜고 AI 3대장 카페를 엽니다.
# (크롬이 꺼져 있든 이미 켜져 있든 똑같이 동작하며,
#  별도의 권한 허용이 필요 없습니다)
#
# 원리: 표식이 붙은 주소(#3ai-cafe)로 사이트를 열면
#       확장이 그 표식을 보고 3대장 창과 명령바를 정렬해 엽니다.
#
# Dock에 넣어 두려면: 이 파일을 Dock 오른쪽(휴지통 옆)으로 끌어다 놓으세요.
# ============================================================

echo "AI 3대장 카페를 엽니다..."
open -a "Google Chrome" "https://gemini.google.com/app#3ai-cafe"
