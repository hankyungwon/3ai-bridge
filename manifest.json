{
  "manifest_version": 3,
  "name": "AI 3대장(제비·참새·하마) 카페",
  "version": "1.17.0",
  "description": "제비(Gemini)·참새(ChatGPT)·하마(Claude) 3대장에게 질문을 한 번에 보내고 한 화면에서 부리는 확장 프로그램",
  "permissions": [
    "storage",
    "tabs",
    "windows",
    "scripting",
    "system.display"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AI 3대장 카페 — 명령바 열기"
  },
  "options_page": "options.html",
  "commands": {
    "open-three": {
      "suggested_key": {
        "default": "Alt+3",
        "mac": "MacCtrl+3"
      },
      "description": "3대장 호출 — 창 3개 배치 + 명령바"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "selectors.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  }
}