{
  "manifest_version": 3,
  "name": "AI 3대장(제비·참새·하마) 브리지",
  "version": "1.6.0",
  "description": "제비(Gemini)·참새(ChatGPT)·하마(Claude) 3대장에게 질문을 한 번에 보내고 한 화면에서 부리는 확장 프로그램",
  "permissions": [
    "storage",
    "tabs",
    "windows",
    "scripting",
    "system.display"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AI 3대장 브리지 — 명령바 열기"
  },
  "options_page": "options.html",
  "commands": {
    "open-three": {
      "suggested_key": {
        "default": "Alt+3"
      },
      "description": "3개 창 열고 배치 + 명령바 띄우기"
    },
    "focus-left": {
      "suggested_key": {
        "default": "Alt+1"
      },
      "description": "왼쪽 AI 창 앞으로"
    },
    "focus-center": {
      "suggested_key": {
        "default": "Alt+2"
      },
      "description": "가운데 AI 창 앞으로 (겹침 배치에서 가려졌을 때)"
    },
    "focus-right": {
      "suggested_key": {
        "default": "Alt+4"
      },
      "description": "오른쪽 AI 창 앞으로"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "selectors.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  }
}